APP_NAME=distributed-educational-ai-ecosystem
LOG_LEVEL=INFO

# Service Gateways & Ports
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
CONTENT_PIPELINE_URL=http://content-pipeline:8001
INFERENCE_SERVICE_URL=http://inference-service:8010
PIHUB_URL=http://pihub:8020
PACK_SERVICE_URL=http://pack-service:8030
EXPERIMENT_SERVICE_URL=http://experiment-service:8040
VOICE_SERVICE_URL=http://voice-service:8050

# Security & Secrets
JWT_SECRET_KEY=change-me-super-secret-jwt-key-min32chars

# Databases
# PostgreSQL (Relational DB for users, courses, curriculum data)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/pihub

# MongoDB (Document store for media metadata & offline enrichment)
MONGO_URL=mongodb://mongo:27017
MONGO_DB=pihub
ENABLE_MONGO_STORAGE=true

# Qdrant Vector Store (RAG embeddings & hybrid search)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=educational_chunks_bge_m3

# STT & TTS Providers
STT_PROVIDER=gemma4_audio
TTS_PROVIDER=auto

# Embeddings & Retrieval
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=/shared/models/sentence-transformers/embedding
LOCAL_RETRIEVAL_MODEL_NAME=BAAI/bge-m3
LOCAL_RETRIEVAL_DEVICE=cpu

# Shared Directory Paths
UPLOAD_DIR=/shared/uploads
WORK_DIR=/shared/work
CONTENT_DIR=/shared/content
MEDIA_STORAGE_PATH=/shared/media
PACK_STORAGE_PATH=/shared/packs
