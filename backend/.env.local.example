# ==============================================================================
# PIHUB Backend Local Overrides Template (.env.local.example)
#
# Copy this file to .env.local to customize local data directories, GGUF models,
# and database paths without copying heavy binaries or dataset files.
# (.env.local is git-ignored and will not be committed).
# ==============================================================================

# Shared local data root directory
PIHUB_DATA_ROOT=/home/akash/Desktop/NOTIMP/pihub/backend/.local_run

# Individual storage path overrides (defaults resolve inside PIHUB_DATA_ROOT)
PACKS_DIR=/home/akash/Desktop/NOTIMP/pihub/backend/.local_run/packs
TEXTBOOKS_DIR=/home/akash/Desktop/NOTIMP/pihub/backend/.local_run/textbooks
PIHUB_DB_PATH=/home/akash/Desktop/NOTIMP/pihub/backend/.local_run/pihub.sqlite3

# Vector Database and LLM Model paths
QDRANT_URL=http://localhost:6333
MONGO_URL=mongodb://localhost:27017
LLAMA_MODEL_PATH=/home/akash/Desktop/NOTIMP/pihub/backend/inference-service/models/model.gguf
