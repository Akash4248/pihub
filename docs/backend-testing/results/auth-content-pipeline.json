{
  "service": "content-pipeline",
  "base": "http://localhost:8001",
  "protected_endpoint": "/ingest/status",
  "checks": {
    "without_credentials": {
      "status": 401,
      "rejected": true
    },
    "with_internal_key": {
      "status": 422,
      "accepted": true
    },
    "with_wrong_key": {
      "status": 401,
      "rejected": true
    }
  },
  "ok": true
}